import os
import time
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.chrome.service import Service as ChromeService
from selenium.webdriver.chrome.options import Options as ChromeOptions
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

URL_DA_PAGINA_DE_LOGIN = "https://ava.grupoceuma.com.br/"
SEU_USUARIO = "08435433102"
SUA_SENHA = "08435433102"

SELETOR_DO_CAMPO_USUARIO = (By.ID, "username")
SELETOR_DO_CAMPO_SENHA = (By.ID, "password")
# Seletor para o BOTÃO azul do formulário
SELETOR_DO_BOTAO_LOGIN = (By.XPATH, "//button[normalize-space()='Acessar']")

URL_DIRETA_DA_PAGINA_DA_MATERIA = "https://ead.unieuro.edu.br/course/view.php?id=3176"
SELETOR_DO_LINK_DO_ARQUIVO = (By.PARTIAL_LINK_TEXT, "globo.pdf")

diretorio_download = os.path.join(os.path.expanduser("~"), "Downloads", "downloads_faculdade")

if not os.path.exists(diretorio_download):
    os.makedirs(diretorio_download)

chrome_options = ChromeOptions()
chrome_options.add_argument("--start-maximized")
chrome_options.add_argument("user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36")

prefs = {
    "download.default_directory": diretorio_download,
    "download.prompt_for_download": False,
    "download.directory_upgrade": True,
    "plugins.always_open_pdf_externally": True
}
chrome_options.add_experimental_option("prefs", prefs)

caminho_chromedriver = "chromedriver.exe"
servico = ChromeService(executable_path=caminho_chromedriver)

driver = webdriver.Chrome(service=servico, options=chrome_options)
wait = WebDriverWait(driver, 30)

try:
    print("Acessando o portal AVA...")
    driver.get(URL_DA_PAGINA_DE_LOGIN)
    
    print("Selecionando a instituição (Unieuro)...")
    seletor_instituicao = (By.ID, "unieuro")
    botao_instituicao = wait.until(EC.element_to_be_clickable(seletor_instituicao))
    botao_instituicao.click()
    
    wait.until(EC.url_contains("ead.unieuro.edu.br"))
    
    # Seletor para o LINK de texto "Acessar" no canto da página inicial
    print("Clicando no link 'Acessar' para ir à página de login...")
    link_de_login = wait.until(EC.element_to_be_clickable((By.LINK_TEXT, "Acessar")))
    link_de_login.click()
    
    print("Agora na página de login. Preenchendo usuário e senha...")
    
    campo_usuario = wait.until(EC.presence_of_element_located(SELETOR_DO_CAMPO_USUARIO))
    campo_senha = wait.until(EC.presence_of_element_located(SELETOR_DO_CAMPO_SENHA))
    
    campo_usuario.send_keys(SEU_USUARIO)
    campo_senha.send_keys(SUA_SENHA)
    
    print("Clicando no botão de login...")
    botao_login = wait.until(EC.element_to_be_clickable(SELETOR_DO_BOTAO_LOGIN))
    botao_login.click()
    
    print("Login efetuado. Aguardando o painel carregar...")
    wait.until(EC.presence_of_element_located((By.ID, "user-menu-toggle")))

    print("Navegando para a página da matéria...")
    driver.get(URL_DIRETA_DA_PAGINA_DA_MATERIA)
    
    print("Procurando o link da página do arquivo...")
    link_arquivo = wait.until(EC.presence_of_element_located(SELETOR_DO_LINK_DO_ARQUIVO))
    
    url_pagina_arquivo = link_arquivo.get_attribute('href')
    print(f"URL da página do arquivo encontrada: {url_pagina_arquivo}")
    
    print("Navegando para a página do arquivo para iniciar o download...")
    driver.get(url_pagina_arquivo)
    
    tempo_de_espera = 20
    print(f"Aguardando {tempo_de_espera} segundos para o download concluir...")
    time.sleep(tempo_de_espera)
    
    print(f"Download finalizado! Verifique a pasta: {diretorio_download}")

finally:
    driver.quit()
